@page
@model IndexModel
@{
    ViewData["Title"] = "Chatbot";
}

<div id="app" data-api-base="@Model.ApiBaseUrl">

    <!-- Authentication -->
    <section id="auth-view" class="auth-view" hidden>
        <div class="auth-card">
            <div class="brand"><span class="brand-mark">✦</span> Chatbot <span class="brand-name">AI Engineering Foundry</span></div>
            <div class="auth-tabs" role="tablist">
                <button type="button" class="auth-tab active" data-mode="login" role="tab" aria-selected="true">Sign in</button>
                <button type="button" class="auth-tab" data-mode="register" role="tab" aria-selected="false">Create account</button>
            </div>
            <form id="auth-form" novalidate>
                <label class="field register-only" hidden>
                    <span>Display name</span>
                    <input name="displayName" type="text" maxlength="100" autocomplete="nickname" />
                </label>
                <label class="field">
                    <span>Email</span>
                    <input name="email" type="email" required maxlength="256" autocomplete="email" />
                </label>
                <label class="field">
                    <span>Password</span>
                    <input name="password" type="password" required minlength="8" maxlength="128" autocomplete="current-password" />
                </label>
                <p class="hint register-only" hidden>At least 8 characters, including a letter and a digit.</p>
                <p id="auth-error" class="form-error" role="alert" hidden></p>
                <button id="auth-submit" type="submit" class="btn btn-primary btn-block">Sign in</button>
            </form>
        </div>
    </section>

    <!-- Chat -->
    <section id="chat-view" class="chat-view" hidden>
        <aside id="sidebar" class="sidebar" aria-label="Conversations">
            <div class="sidebar-header">
                <div class="brand"><span class="brand-mark">✦</span> Chatbot <span class="brand-name">AI Engineering Foundry</span></div>
                <button id="close-sidebar" type="button" class="icon-btn mobile-only" aria-label="Close sidebar">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" /></svg>
                </button>
            </div>
            <button id="new-chat" type="button" class="btn btn-primary btn-block">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5v14M5 12h14" /></svg>
                New conversation
            </button>
            <nav>
                <ul id="conversation-list" class="conversation-list"></ul>
                <p id="conversation-empty" class="muted small" hidden>No conversations yet.</p>
            </nav>
            <div class="sidebar-footer">
                <span id="user-name" class="user-name"></span>
                <button id="logout" type="button" class="btn btn-ghost btn-sm">Sign out</button>
            </div>
        </aside>
        <div id="sidebar-backdrop" class="sidebar-backdrop" hidden></div>

        <main class="chat-main">
            <header class="chat-header">
                <button id="open-sidebar" type="button" class="icon-btn mobile-only" aria-label="Open conversations">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 6h16M4 12h16M4 18h16" /></svg>
                </button>
                <h1 id="chat-title" class="chat-title">New conversation</h1>
                <span id="connection-status" class="connection-status" title="Real-time connection"></span>
            </header>

            <div id="connection-banner" class="banner" role="status" hidden></div>

            <div id="messages" class="messages" aria-live="polite">
                <div id="welcome" class="welcome">
                    <div class="welcome-mark">✦</div>
                    <h2>How can I help today?</h2>
                    <p class="muted">Ask a question, paste some code, or start brainstorming.</p>
                </div>
            </div>

            <form id="composer" class="composer" autocomplete="off">
                <div class="composer-inner">
                    <textarea id="message-input" rows="1" placeholder="Message Chatbot…" aria-label="Message" maxlength="8000"></textarea>
                    <button id="send" type="submit" class="send-btn" aria-label="Send message" disabled>
                        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
                    </button>
                </div>
                <p class="composer-hint muted small">Enter to send · Shift+Enter for a new line</p>
            </form>
        </main>
    </section>

    <div id="toasts" class="toasts" aria-live="assertive"></div>
</div>

@section Scripts {
    <script src="~/lib/signalr/signalr.min.js" asp-append-version="true"></script>
    <script src="~/lib/marked/marked.umd.js" asp-append-version="true"></script>
    <script src="~/lib/dompurify/purify.min.js" asp-append-version="true"></script>
    <script src="~/lib/highlight/highlight.min.js" asp-append-version="true"></script>
    <script src="~/js/app.js" asp-append-version="true"></script>
}
